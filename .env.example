# Project Omega OCO runtime configuration

# Feishu transport is owned by botmux. Keep LARK_APP_ID/LARK_APP_SECRET in
# ~/.botmux/bots.json; do not add them to this file.

# Default local backend: OpenAI-compatible llama.cpp.
# This is the baseline configuration and remains unchanged unless the provider
# is explicitly switched to ollama below.
OCO_LOCAL_LLM_PROVIDER=llama.cpp
OCO_LOCAL_LLM_URL=http://127.0.0.1:8081/v1/chat/completions
OCO_LOCAL_LLM_MODEL=qwen

# Optional Ollama native backend. Uncomment these lines together to use it.
# OCO_LOCAL_LLM_PROVIDER=ollama
# OCO_LOCAL_LLM_URL=http://127.0.0.1:11434/api/chat
# OCO_LOCAL_LLM_MODEL=ollama/dolphin3-mistral-32k:latest
# OCO_OLLAMA_NUM_CTX=2048
# OCO_OLLAMA_TIMEOUT=300

# Use cloud model through OpenRouter.
USE_CLOUD_LLM=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Optional WSL/remote MCP paths. The current research adapter still contains
# legacy WSL defaults; use these variables as the target contract for cleanup.
OCO_MCP_PYTHON=
OCO_MCP_PROJECT_ROOT=
